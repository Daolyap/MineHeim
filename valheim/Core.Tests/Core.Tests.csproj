<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unity-free tests for valheim/Core: coordinate mapping, message formatting, and the WebSocket client against a live
       Minecraft (dotnet run with the argument live). The Core sources are linked in, exactly as the plugin compiles them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MineHeim.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
